---
import { getCollection } from "astro:content";

const pathname = Astro.url.pathname;

const mixes = await getCollection("mixes");
const videos = await getCollection("videos", ({ data }) => !data.draft);
const projects = await getCollection("projects");
const posts = await getCollection("blog", ({ data }) => !data.draft);

const links = [
  mixes.length > 0 && { href: "/mixes", label: "Mixes" },
  videos.length > 0 && { href: "/videos", label: "Videos" },
  projects.length > 0 && { href: "/projects", label: "Projects" },
  posts.length > 0 && { href: "/blog", label: "Blog" },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
	<div class="mx-auto max-w-5xl px-6 h-14 flex items-center justify-between">
		<a href="/" class="font-bold tracking-tight text-white hover:text-zinc-300 transition-colors">
			ujo4eva
		</a>

		<nav class="flex items-center gap-1 sm:gap-2">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={[
							"px-3 py-1.5 rounded-full text-sm font-medium transition-colors",
							pathname.startsWith(link.href)
								? "text-white bg-white/10"
								: "text-zinc-400 hover:text-white hover:bg-white/5",
						]}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>