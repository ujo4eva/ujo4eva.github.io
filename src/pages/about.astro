---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — ujo4eva">
	<main class="min-h-screen bg-zinc-950 text-white px-6 py-24">
		<article class="max-w-2xl mx-auto">
			<h1 class="text-4xl sm:text-5xl font-bold mb-6 tracking-tight">
				About Me
			</h1>

			<p class="text-lg leading-relaxed text-zinc-300 mb-4">
				I'm an audio engineer who loves tech, fitness, and thinking about
				culture, faith, politics, gaming, and media. This is my corner of the
				internet.
			</p>

			<p class="text-lg leading-relaxed text-zinc-400">
				More coming soon — blog posts, projects, and maybe a playlist or two.
			</p>

			<div class="mt-12">
				<a
					href="/"
					class="inline-block border border-white/30 px-6 py-3 rounded-full font-medium text-zinc-300 hover:bg-white/10 hover:text-white transition-colors"
				>
					&larr; Back home
				</a>
			</div>
		</article>
	</main>
</Layout>
