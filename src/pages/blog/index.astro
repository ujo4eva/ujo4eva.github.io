---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sorted = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Blog — ujo4eva">
  <main class="min-h-screen bg-zinc-950 text-white px-6 py-24">
    <div class="max-w-2xl mx-auto">
      <a
        href="/"
        class="inline-block text-zinc-400 hover:text-white transition-colors mb-12"
      >
        &larr; Back home
      </a>

      <h1 class="text-4xl sm:text-5xl font-bold mb-12 tracking-tight">Blog</h1>

      {sorted.length === 0 && (
        <p class="text-zinc-500">No posts yet. Check back soon.</p>
      )}

      <ul class="space-y-8">
        {sorted.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group block border-b border-zinc-800 pb-6"
            >
              <h2 class="text-xl font-semibold group-hover:text-zinc-300 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-zinc-500 text-sm mt-1">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <p class="text-zinc-400 mt-2">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>
