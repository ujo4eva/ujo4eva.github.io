---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects');
const sorted = projects.sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Projects — ujo4eva" description="Open-source projects from Osadebamwen Uwadiae.">
  <main class="min-h-screen bg-zinc-950 text-white px-6 pt-24 pb-24">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold mb-2 tracking-tight">Projects</h1>
      <p class="text-zinc-500 mb-12">Things I've built.</p>

      {sorted.length === 0 && (
        <p class="text-zinc-500">No projects yet. Check back soon.</p>
      )}

      <div class="grid gap-6 sm:grid-cols-2">
        {sorted.map((project) => (
          <a
            href={project.data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-zinc-800 rounded-2xl p-6 bg-zinc-900/40 hover:border-zinc-600 transition-colors"
          >
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-semibold group-hover:text-zinc-300 transition-colors">
                {project.data.title}
              </h2>
              {project.data.featured && (
                <span class="shrink-0 border border-white/20 rounded-full px-3 py-0.5 text-xs text-zinc-400 uppercase tracking-wide">
                  Featured
                </span>
              )}
            </div>
            <p class="text-zinc-400 text-sm mt-2 leading-relaxed">
              {project.data.description}
            </p>
            {project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {project.data.tags.map((tag) => (
                  <span
                    class="rounded-full bg-white/10 px-3 py-1 text-xs text-zinc-300"
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>