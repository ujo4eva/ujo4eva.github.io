---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const videos = await getCollection('videos', ({ data }) => !data.draft);

function getYouTubeId(url: string): string | null {
  const match = url.match(
    /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/,
  );
  return match ? match[1] : null;
}

const sorted = videos.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Videos — ujo4eva" description="Videos edited and graded by Osadebamwen Uwadiae.">
  <main class="min-h-screen bg-zinc-950 text-white px-6 pt-24 pb-24">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold mb-2 tracking-tight">Videos</h1>
      <p class="text-zinc-500 mb-12">Work I've edited and/or graded.</p>

      {sorted.length === 0 && (
        <p class="text-zinc-500">No videos yet. Check back soon.</p>
      )}

      <div class="grid gap-10 sm:grid-cols-2">
        {sorted.map((video) => {
          const id = getYouTubeId(video.data.videoUrl);
          const thumb = id
            ? `https://img.youtube.com/vi/${id}/hqdefault.jpg`
            : null;
          return (
            <a
              href={video.data.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              {thumb && (
                <div class="aspect-video overflow-hidden rounded-xl bg-zinc-900 mb-3 group-hover:ring-2 group-hover:ring-zinc-600 transition-all">
                  <img
                    src={thumb}
                    alt={video.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-semibold group-hover:text-zinc-300 transition-colors">
                  {video.data.title}
                </h2>
                <span class="shrink-0 border border-white/20 rounded-full px-3 py-0.5 text-xs text-zinc-400 uppercase tracking-wide">
                  {video.data.role}
                </span>
              </div>
              {video.data.description && (
                <p class="text-zinc-500 text-sm mt-1.5 leading-relaxed">
                  {video.data.description}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </main>
</Layout>