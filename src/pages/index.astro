---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ujo4eva">
	<main
		class="min-h-screen bg-zinc-950 text-white flex items-center justify-center px-6"
	>
		<div class="text-center max-w-lg">
			<h1 class="text-5xl sm:text-7xl font-bold mb-4 tracking-tight">
				Osadebamwen<br />Uwadiae
			</h1>

			<p class="text-lg sm:text-2xl text-zinc-400 mb-12 max-w-md mx-auto">
				Audio Engineer &bull; Tech &bull; Fitness &bull; Culture
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/about"
					class="bg-white text-black px-8 py-4 rounded-full font-medium hover:bg-zinc-200 transition-colors"
				>
					About Me
				</a>

				<a
					href="/blog"
					class="border border-white/30 px-8 py-4 rounded-full font-medium text-zinc-300 hover:bg-white/10 hover:text-white transition-colors"
				>
					Read the Blog
				</a>
			</div>
		</div>
	</main>
</Layout>
