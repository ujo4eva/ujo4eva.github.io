---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const mixes = await getCollection('mixes');
const sorted = mixes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Mixes — ujo4eva" description="Music mixes by Osadebamwen Uwadiae — the play button is the story.">
  <main class="min-h-screen bg-zinc-950 text-white px-6 pt-24 pb-24">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold mb-2 tracking-tight">Mixes</h1>
      <p class="text-zinc-500 mb-12">Songs I've mixed.</p>

      {sorted.length === 0 && (
        <p class="text-zinc-500">No mixes yet. Check back soon.</p>
      )}

      <div class="grid gap-8 sm:grid-cols-2">
        {sorted.map((mix) => (
          <div class="border border-zinc-800 rounded-2xl p-5 bg-zinc-900/40">
            <h2 class="text-lg font-semibold text-white">{mix.data.title}</h2>
            <p class="text-zinc-400 text-sm mt-0.5 mb-4">
              {mix.data.artist}
              {mix.data.genre && <span class="text-zinc-600"> · {mix.data.genre}</span>}
            </p>

            <iframe
              src={mix.data.embedUrl}
              title={mix.data.title}
              width="100%"
              height="140"
              scrolling="no"
              frameborder="no"
              allow="autoplay"
              class="rounded-lg"
            ></iframe>

            {mix.data.description && (
              <p class="text-zinc-500 text-sm mt-4 leading-relaxed">
                {mix.data.description}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>